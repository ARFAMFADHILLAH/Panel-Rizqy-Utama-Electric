# ==== Database utama: Supabase (Postgres) ====
# Sama persis dengan toko pelanggan — satu database, dua aplikasi.
# Selama variabel ini terisi, panel memakai Postgres. Ambil nilainya dari
# .env.local storefront (SUPABASE_DB_URL) atau Supabase Dashboard >
# Settings > Database > Connection string (URI, mode Session/Pooler).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres

# ==== Database cadangan: MySQL ====
# Hanya dipakai bila SUPABASE_DB_URL kosong.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=rizqyutamaelectric

# ==== Toko (dipakai untuk judul & tombol "Lihat Toko") ====
NEXT_PUBLIC_STORE_NAME="Rizqy Utama Electric"
NEXT_PUBLIC_WA_NUMBER=6281234567890
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# ==== Panel Admin ====
# Kunci HMAC untuk menandatangani cookie session.
# Generate: openssl rand -base64 32
SESSION_SECRET=

# Origin publik panel. Dipakai untuk menyusun URL gambar produk,
# karena kolom products.image dirender oleh toko pada origin berbeda.
ADMIN_PUBLIC_URL=http://localhost:3001

# Masa berlaku session dalam jam.
ADMIN_SESSION_HOURS=8

# Cookie session memakai flag "Secure" otomatis saat produksi.
# Set "false" HANYA untuk pengujian lokal lewat http://localhost,
# karena browser tidak mengirim cookie Secure melalui HTTP.
# ADMIN_COOKIE_SECURE=false

# ==== Asisten AI Inventori ====
# Daftar email admin yang boleh memakai fitur AI, dipisah koma.
# KOSONG = fitur AI NONAKTIF (menu & endpoint tertutup).
AI_ALLOWED_EMAILS=owner@example.com

# API key Google Gemini (GRATIS, tanpa kartu kredit).
# Ambil di https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opsional. Default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# ==== Google Sheets (Service Account) ====
# isi client_email & private_key dari file JSON service account.
# PENTING: setiap spreadsheet harus di-Share ke GOOGLE_SERVICE_ACCOUNT_EMAIL
# sebagai Viewer, kalau tidak Sheets API membalas 404/403.
GOOGLE_SERVICE_ACCOUNT_EMAIL=asisten@<project>.iam.gserviceaccount.com
# tempel private_key apa adanya (boleh dengan \n literal dari JSON)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Daftar spreadsheet, format JSON array. Range default A:Z.
# Bisa menunjuk tab tertentu dengan range "'NAMA TAB'!A:Z".
# Opsional per entri:
#   "columns":     peta kolom eksplisit {name,price,stock,sku,description} (stock boleh null)
#   "defaultStock": stok bila sheet tidak punya kolom stok
#   "seriesRows":  true bila ada baris label seri yang jadi prefix nama produk
#   "namePrefix":  teks prefix nama produk (mis. merek "HOZAN" -> "HOZAN B 50EE")
GOOGLE_SHEETS_CONFIG=[{"name":"SANWA","id":"<spreadsheet-id-alat-ukur>","range":"'SANWA'!A:Z","columns":{"name":"TIPE","price":"HARGA TETAP (OFFLINE)","stock":"STOK","sku":"TIPE"},"namePrefix":"SANWA"},{"name":"HOZAN","id":"<spreadsheet-id-alat-ukur>","range":"'HOZAN'!A:Z","columns":{"name":"TIIPE","price":"HARGA TETAP (OFFLINE)","stock":"STOK","sku":"TIIPE"},"namePrefix":"HOZAN"},{"name":"AC","id":"<spreadsheet-id-ac>","range":"A:Z","columns":{"name":"TIPE","price":"HARGA TETAP (OFFLINE)","stock":null,"sku":"TIPE"},"defaultStock":100,"seriesRows":true}]

# ==== Notifikasi Email (Gmail SMTP + App Password) ====
# Buat App Password di https://myaccount.google.com/apppasswords
# (wajib aktifkan 2FA lebih dulu).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=akun@gmail.com
SMTP_PASSWORD=
# Tujuan notifikasi. Default: SMTP_USER
NOTIFY_TO=akun@gmail.com

# Ambang "stok menipis" (produk dengan stock <= nilai ini). Default 5.
LOW_STOCK_THRESHOLD=5

# Secret untuk memicu laporan harian via GET /api/cron/daily-report
# (header: Authorization: Bearer <CRON_SECRET>). Generate: openssl rand -hex 24
CRON_SECRET=
